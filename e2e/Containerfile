# E2E test container: real Thunderbird (not Firefox - see e2e/README.md
# for why that distinction matters), driven headlessly over Marionette
# (the same remote-automation protocol geckodriver speaks to Firefox;
# Thunderbird has shipped it since Thunderbird 69 - Bugzilla 1543725) by
# Robot Framework via a small custom keyword library (e2e/robot/
# CussijnLibrary.py) rather than SeleniumLibrary/Browser, since there is
# no geckodriver-for-Thunderbird and no ready-made Robot Framework
# library for it.
FROM docker.io/library/debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       thunderbird xvfb python3 python3-pip zip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --break-system-packages --no-cache-dir \
    robotframework==7.* marionette_driver==3.*

WORKDIR /work
ENTRYPOINT ["/work/e2e/entrypoint.sh"]
